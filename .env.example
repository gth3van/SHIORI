# SHIORI — Environment Variables
# Copy this file to .env and fill in your keys.
# .env is gitignored — your keys are never uploaded to GitHub.

# --------------------------------------------------
# Tavily AI Search (Primary web search provider)
# Get your free API key at: https://app.tavily.com
# Free tier: 1000 requests/month
# --------------------------------------------------
TAVILY_API_KEY=tvly-your-key-here

# --------------------------------------------------
# SearXNG (Fallback — self-hosted, optional)
# Run locally: docker run -d -p 8080:8080 searxng/searxng
# Default URL below — change if you use a different port
# --------------------------------------------------
SEARXNG_URL=http://localhost:8080
